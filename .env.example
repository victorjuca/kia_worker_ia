# Copia este archivo como .env y llena los valores. El .env NO se sube a git.

# --- Base de datos (la misma de kia: src/kia/source/configuracion_db.properties)
DB_HOST=
DB_PORT=5432
DB_NAME=kia
DB_USER=
DB_PASSWORD=

# --- Maquina en la tabla "maquina" (columna mac).
# En Windows, vacio = el mismo identificador que usa kia en este equipo (comparte su configuracion de procesos).
# En Docker es obligatorio: da de alta una maquina para el worker y pon aqui su identificador.
WORKER_MAQUINA_ID=

# --- Carpetas de ESTE equipo / contenedor
PATH_MAIN=C:\kia_colaboradores_online\karaoke_ia
KIA_TEMP=C:\kia_main\kia_temp
# MODELOS_DIR=C:\Users\turing\Documents\claude\kia-worker-ia\modelos

# Raices con las que kia guardo las rutas en la fila (separadas por ;). Normalmente no se cambia.
# PATH_MAIN_ALIAS=C:\kia_colaboradores_online\karaoke_ia;C:\kia_colaboradores_online\KARAOKE IA

# --- Whisper
WHISPER_MODELO=large-v3-turbo
WHISPER_IDIOMA=es
WHISPER_DEVICE=cuda

# --- Otros
# FFMPEG=ffmpeg
# INTERVALO_SEG=10
# UN_PROCESO_POR_MAQUINA=true   # un proceso a la vez en esta maquina entre el worker IA y kia-render
# LOG_LEVEL=INFO
# LIBERAR_GPU=true   # solo un modelo a la vez en la GPU (8 GB); false si la GPU tiene 16 GB o mas
# SEPARADOR_AUTOCAST=false   # true: separa en media precision (mas rapido en RTX)
# SEPARADOR_OVERLAP=         # vacio = el del modelo; menos = mas rapido (2 o 4), mas = mejor calidad (8)

# Descargar Cancion (tipo 10)
# YTDLP_JS_RUNTIME=node          # JavaScript para yt-dlp: node (el que usa kia) o deno
# YTDLP_COOKIES=                 # opcional: cookies.txt de YouTube
# YTDLP_ACTUALIZAR=true          # si falla, actualiza yt-dlp una vez y reintenta
# FUENTE_PORTADA=C:\Windows\Fonts\ariblk.ttf   # Arial Black para portada.jpg
# PORTADA_AUTO=true              # ajuste automatico del nombre en la portada (img.auto.ajuste de kia)
